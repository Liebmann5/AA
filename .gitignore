# Global Git Ignore for Entire Monorepo

# --- Python Environments ---
.venv/
env/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Build Artifacts ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- IDEs / Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs & Temporary Files ---
*.log
*.tmp
*.bak
*.orig

# --- OS-Specific ---
.DS_Store
Thumbs.db

# --- Local Notes / Artifacts ---
.local/
notes/
*.secret

# --- Tooling caches ---
.mypy_cache/
.pytest_cache/
.hypothesis/
.ruff_cache/

.env
output/
Notes/

# --- Live-run and AI-tooling artifacts ---
.kimi_out/
.kimi_backups/
AA-kimi.txt
session_log*.txt
measure_*.txt

packages/auto_apply/dev_data/

# Exported profiles carry real name, email, phone and address.
# AA's export dialog can write anywhere, including here.
*.profile.json
packages/*.json
/aa_results_*.csv
packages/**/aa_results_*.csv

# --- Documentation build output ---
# `mkdocs build` writes packages/auto_apply/site/ -- 113 generated HTML files
# on the current tree. It is build output, regenerated on every build, and it
# does not belong in the repository. This goes in the tracked .gitignore rather
# than a local exclude because every contributor who builds the docs will
# produce it.
packages/auto_apply/site/
site/
